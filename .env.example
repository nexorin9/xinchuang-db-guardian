# 信创数据库合规漂移守护 · 环境变量样例（信息科按需填写）
# 复制为 .env 后填入真实值；绝不入库

# 探测数据库最小权限账号（仅发 PG Q SELECT 1 与 DM/Oracle TNS banner，不 SELECT 业务表）
DB_PROBE_USER=xc_probe

# 企业微信群机器人 webhook（命中漂移时推送 markdown 卡片）
WECHAT_WEBHOOK_URL=

# SMTP（邮件备用通道）
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=xc-guardian@example.com
SMTP_PASSWORD=
SMTP_FROM=xc-guardian@example.com
SMTP_TO=ops@example.com

# LLM 网关（OpenAI-compatible；不可达时降级回规则 verdict + need_human_review=true）
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
LLM_TIMEOUT_SECS=10

# 守护进程与日志
XINCHUANG_PIDFILE=/var/run/xc-guardian.pid
XINCHUANG_LOG_LEVEL=info
XINCHUANG_AUDIT_FILE=/var/log/xinchuang-guardian/audit.jsonl
XINCHUANG_DB_FILE=/var/lib/xinchuang-guardian/trial_state.db
DEDUP_WINDOW_SECS=300